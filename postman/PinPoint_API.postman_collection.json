{
  "info": {
    "_postman_id": "pinpoint-backend-api-v1",
    "name": "PinPoint Backend API",
    "description": "Comprehensive API collection for PinPoint Backend with automated JWT authentication and all endpoints from the specification.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Public",
      "item": [
        {
          "name": "Submit Contact Inquiry",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Jane Doe\",\n  \"businessName\": \"Safari Ventures\",\n  \"email\": \"jane@safariventures.com\",\n  \"industry\": \"Tourism\",\n  \"message\": \"We would like to request a demo of the PinPoint platform.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/public/contact",
              "host": ["{{baseUrl}}"],
              "path": ["public", "contact"]
            }
          }
        }
      ]
    },
    {
      "name": "Authentication & Profile",
      "item": [
        {
          "name": "User Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.success && response.data && response.data.token) {",
                  "    pm.environment.set('token', response.data.token);",
                  "    console.log('JWT token automatically set in environment variables');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"pinadmin@gmail.com\",\n  \"password\": \"pin@2026\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Get User Profile & Billing",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/user/profile",
              "host": ["{{baseUrl}}"],
              "path": ["user", "profile"]
            }
          }
        },
        {
          "name": "Update User Profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Calvin Muema\",\n  \"email\": \"admin@pinpoint.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/user/profile",
              "host": ["{{baseUrl}}"],
              "path": ["user", "profile"]
            }
          }
        }
      ]
    },
    {
      "name": "Leads Intelligence",
      "item": [
        {
          "name": "Fetch All Leads",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/leads?search=&scoreFilter=Hot&status=New&page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["leads"],
              "query": [
                { "key": "search", "value": "" },
                { "key": "scoreFilter", "value": "Hot" },
                { "key": "status", "value": "New" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Manually Generate / Intercept Lead",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"details\": \"Looking for a 5-day luxury resort recommendation in Mombasa next month for a family of 4.\",\n  \"destination\": \"Mombasa\",\n  \"travelType\": \"Leisure\",\n  \"budget\": 2500,\n  \"source\": \"Reddit\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/leads",
              "host": ["{{baseUrl}}"],
              "path": ["leads"]
            }
          }
        },
        {
          "name": "Get Lead Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/leads/:id",
              "host": ["{{baseUrl}}"],
              "path": ["leads", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "ENTER_LEAD_UUID_HERE"
                }
              ]
            }
          }
        },
        {
          "name": "Update Lead Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Contacted\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/leads/:id/status",
              "host": ["{{baseUrl}}"],
              "path": ["leads", ":id", "status"],
              "variable": [
                {
                  "key": "id",
                  "value": "ENTER_LEAD_UUID_HERE"
                }
              ]
            }
          }
        },
        {
          "name": "Toggle Lead Star Flag",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/leads/:id/star",
              "host": ["{{baseUrl}}"],
              "path": ["leads", ":id", "star"],
              "variable": [
                {
                  "key": "id",
                  "value": "ENTER_LEAD_UUID_HERE"
                }
              ]
            }
          }
        },
        {
          "name": "Archive / Delete Lead",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/leads/:id",
              "host": ["{{baseUrl}}"],
              "path": ["leads", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "ENTER_LEAD_UUID_HERE"
                }
              ]
            }
          }
        },
        {
          "name": "Export Filtered Leads to CSV",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/leads/export?status=New",
              "host": ["{{baseUrl}}"],
              "path": ["leads", "export"],
              "query": [
                { "key": "status", "value": "New" }
              ]
            }
          }
        }
      ]
    },
