NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

JWT_SECRET=super_secret_pinpoint_jwt_key_2026
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=super_secret_pinpoint_refresh_key_2026
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=*

REDIS_URL=redis://localhost:6379

GEMINI_API_KEY=your_gemini_api_key_here

# Nodemailer Configuration (Option 1: Gmail)
# SMTP_SERVICE=gmail
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_gmail_app_password

# Nodemailer Configuration (Option 2: Custom SMTP e.g. Mailtrap, Brevo, SendGrid)
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password

