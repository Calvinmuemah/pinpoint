                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sources\": [\n    {\n      \"id\": \"Reddit\",\n      \"enabled\": true\n    },\n    {\n      \"id\": \"TripAdvisor\",\n      \"enabled\": false\n    },\n    {\n      \"id\": \"Twitter\",\n      \"enabled\": true\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/settings/sources",
              "host": ["{{baseUrl}}"],
              "path": ["settings", "sources"]
            }
          }
        },
        {
          "name": "Adjust AI Scoring Rules",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scoringRules\": [\n    {\n      \"criterion\": \"Specific destination mentioned\",\n      \"weight\": 25,\n      \"description\": \"Lead explicitly mentions a travel destination\",\n      \"enabled\": true\n    },\n    {\n      \"criterion\": \"Travel date or timeframe provided\",\n      \"weight\": 25,\n      \"description\": \"Lead provides specific travel timeframe\",\n      \"enabled\": true\n    },\n    {\n      \"criterion\": \"Budget details provided\",\n      \"weight\": 20,\n      \"description\": \"Lead provides a budget figure\",\n      \"enabled\": true\n    },\n    {\n      \"criterion\": \"Explicitly looking for tour operator\",\n      \"weight\": 30,\n      \"description\": \"Lead asks for recommendations or quotes\",\n      \"enabled\": true\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/settings/scoring-rules",
              "host": ["{{baseUrl}}"],
              "path": ["settings", "scoring-rules"]
            }
          }
        }
